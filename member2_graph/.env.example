# TRUSTRAIL AI - Member 2 Neo4j Configuration
# Copy this file to .env and fill in your Neo4j Aura credentials.
# NEVER commit .env - it is gitignored.

# Neo4j Aura connection URI (example: neo4j+s://<instance-id>.databases.neo4j.io)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io

# Neo4j username (default for Aura is 'neo4j')
NEO4J_USERNAME=neo4j

# Neo4j password - obtain from your Aura instance / secrets manager
NEO4J_PASSWORD=your-neo4j-password

# Neo4j database name (optional; uses the server default if unset)
NEO4J_DATABASE=neo4j

# Import batch size (records per transaction)
IMPORT_BATCH_SIZE=500
